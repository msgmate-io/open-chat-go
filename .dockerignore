*
!backend
!Dockerfile
!dev.dockerfile
!frontend
# In-tree frontend: keep host-side deps/build output out of the build context.
frontend/node_modules
frontend/dist
frontend/.vite
!clients
!clients/go_tool_interface
!clients/go_integration_interface
!clients/integrations
!clients/integrations/**
!integrations.yaml
!integrations.lock.json
!profile_setup.yaml
!development
# Only the public build tooling and the private manifest fragment (if present)
# are needed inside the image; the rest of `development/` stays out.
development/*
!development/build-tools
!development/build-tools/**
!development/ci
development/ci/*
!development/ci/openchat
!development/ci/openchat/**
# full_build.sh invokes the integration asset bundler (embeds optional
# integration binaries such as the Rust TUI); keep just that one script.
!development/scripts
development/scripts/*
!development/scripts/bundle_integration_assets.py
# Local Python build artifacts from installing the CLI must not leak into images.
development/build-tools/build
development/build-tools/*.egg-info
development/build-tools/.venv
development/build-tools/**/__pycache__
development/build-tools/**/*.pyc

# Dev-only/generated backend artifacts are bind-mounted at runtime and do not
# need to inflate backend image layers.
backend/.devbin
backend/.tools
backend/docs
backend/.generated
backend/go.work
backend/go.work.sum
backend/integrations/externalintegrations/imports_gen.go
.integrations
integrations.local.yaml

# Keep VCS metadata, local build artifacts and the host-side Go build cache out
# of the build context: they are never used inside the image and previously
# inflated the transferred context (integration `.git` dirs + a stale 165 MB
# backend/backend binary).
**/.git
**/node_modules
**/*.map
.ci-cache
backend/backend
backend/data.db*
# Keep the empty placeholder: server/routing.go has //go:embed all:frontend,
# which needs at least one embeddable file when the frontend stage is empty
# (the core-only smoke build uses frontend_empty). The built frontend is copied
# in from the frontend stage on top of this at image-build time.
backend/server/frontend/*
!backend/server/frontend/.keep
clients/integrations/**/.git

