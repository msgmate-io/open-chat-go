  "sql": "-- Generated schema overview\n\nCREATE TABLE \"users\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"name\" text,\n  \"email\" text,\n  \"password_hash\" text,\n  \"contact_token\" text,\n  \"is_admin\" numeric,\n  \"is_automated\" numeric DEFAULT false,\n  \"two_factor_enabled\" numeric DEFAULT false,\n  \"two_factor_secret\" text\n);\n\nCREATE TABLE \"two_factor_recovery_codes\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"user_id\" integer,\n  \"code_hash\" text,\n  \"used_at\" datetime\n);\n\nCREATE TABLE \"sessions\" (\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"user_id\" integer,\n  \"token\" varchar,\n  \"data\" blob,\n  \"expiry\" datetime\n);\n\nCREATE TABLE \"public_profiles\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"user_id\" integer,\n  \"profile_data\" jsonb\n);\n\nCREATE TABLE \"contacts\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"contact_token\" text,\n  \"owning_user_id\" integer,\n  \"contact_user_id\" integer\n);\n\nCREATE TABLE \"chats\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"user1_id\" integer,\n  \"user2_id\" integer,\n  \"latest_message_id\" integer,\n  \"shared_config_id\" integer,\n  \"chat_type\" text DEFAULT conversation\n);\n\nCREATE TABLE \"shared_chat_configs\" (\n  \"uuid\" uuid,\n  \"id\" integer PRIMARY KEY,\n  \"created_at\" datetime,\n  \"updated_at\" datetime,\n  \"deleted_at\" datetime,\n  \"chat_id\" integer,\n  \"config_data\" jsonb\n);\n\nCREATE TABLE \"chat_setting