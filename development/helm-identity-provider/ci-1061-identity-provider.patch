diff --git a/backend/values.msgmate-io-production.yaml b/backend/values.msgmate-io-production.yaml
index 82c9a47..47b8928 100644
--- a/backend/values.msgmate-io-production.yaml
+++ b/backend/values.msgmate-io-production.yaml
@@ -62,3 +62,22 @@ postgresql:
   external:
     existingSecret: postgres-dsn
     dsnKey: DB_PATH
+
+# ci#1061 - Keycloak at id.msgmate.io as the msgmate.io login provider. The
+# release stays a pure OIDC client (the IdP runs in its own namespace, so an IdP
+# restart never rolls the backend). The chart only points the backend at it; the
+# client secret and the identity-to-user map live in the
+# `open-chat-identity-provider` Secret (keys `client-secret` and
+# `bootstrap-json`), never in this file.
+#
+# allowUnmapped stays false: only identities mapped in that Secret get a local
+# account. Rollback: set `enabled: false` here and `helm upgrade` - the routes go
+# back to 404, the button disappears and password login is unaffected.
+identityProvider:
+  enabled: true
+  preset: keycloak
+  issuer: https://id.msgmate.io/realms/main
+  clientID: open-chat
+  redirectURL: https://msgmate.io/api/v1/integrations/identity_provider/login/callback
+  existingSecret: open-chat-identity-provider
+  allowUnmapped: false
