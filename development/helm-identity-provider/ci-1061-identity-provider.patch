--- a/backend/templates/backend.yaml
+++ b/backend/templates/backend.yaml
@@ -18,6 +18,19 @@
 {{- fail "backend.configFile.existingSecret requires backend.configFile.existingSecretKey" }}
 {{- end }}
 {{- end }}
+{{- $idp := .Values.identityProvider | default dict }}
