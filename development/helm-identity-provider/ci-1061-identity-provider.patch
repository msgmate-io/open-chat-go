 apiVersion: v1
 kind: Secret
 metadata:
@@ -135,6 +148,42 @@ spec:
             - name: OPEN_CHAT_CONFIG
               value: {{ $configFile.path | quote }}
             {{- end }}
+            {{- if $idpEnabled }}
+            # ci#1061 - generic OIDC identity provider. Only the non-secret
+            # settings live here; the client secret and the identity-to-user
+            # bootstrap map are read from the identityProvider.existingSecret.
+            - name: OCI_IDENTITY_PROVIDER_ENABLED
+              value: "true"
+            - name: OCI_IDENTITY_PROVIDER_PRESET
+              value: {{ ($idp.preset | default "keycloak") | quote }}
+            - name: OCI_IDENTITY_PROVIDER_ISSUER
+              value: {{ $idp.issuer | quote }}
+            - name: OCI_IDENTITY_PROVIDER_CLIENT_ID
+              value: {{ $idp.clientID | quote }}
+            - name: OCI_IDENTITY_PROVIDER_REDIRECT_URL
+              value: {{ $idp.redirectURL | quote }}
+            - name: OCI_IDENTITY_PROVIDER_SCOPES
+              value: {{ ($idp.scopes | default "openid profile email") | quote }}
+            {{- if $idp.defaultRole }}
+            - name: OCI_IDENTITY_PROVIDER_DEFAULT_ROLE
+              value: {{ $idp.defaultRole | quote }}
+            {{- end }}
+            - name: OCI_IDENTITY_PROVIDER_ALLOW_UNMAPPED
+              value: {{ ($idp.allowUnmapped | default false) | toString | quote }}
+            - name: OCI_IDENTITY_PROVIDER_CLIENT_SECRET
+              valueFrom:
+                secretKeyRef:
+                  name: {{ $idp.existingSecret | quote }}
+                  key: {{ ($idp.clientSecretKey | default "client-secret") | quote }}
+            - name: OCI_IDENTITY_PROVIDER_BOOTSTRAP_JSON
+              valueFrom:
+                secretKeyRef:
+                  name: {{ $idp.existingSecret | quote }}
+                  key: {{ ($idp.bootstrapJSONKey | default "bootstrap-json") | quote }}
+                  # Optional so a deployment can start before the identity map
