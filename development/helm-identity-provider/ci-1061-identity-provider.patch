+{{- if $idpEnabled }}
+{{- if not $idp.issuer }}
+{{- fail "identityProvider.enabled requires identityProvider.issuer" }}
+{{- end }}
+{{- if not $idp.clientID }}
+{{- fail "identityProvider.enabled requires identityProvider.clientID" }}
+{{- end }}
+{{- if not $idp.existingSecret }}
+{{- fail "identityProvider.enabled requires identityProvider.existingSecret (it holds the OIDC client secret and the identity map; never put either in values)" }}
