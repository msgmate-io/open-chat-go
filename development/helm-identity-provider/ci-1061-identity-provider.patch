diff --git a/backend/values.yaml b/backend/values.yaml
index fb0c138..2238556 100644
--- a/backend/values.yaml
+++ b/backend/values.yaml
@@ -104,3 +104,33 @@ postgresql:
     # password in a values file.
     existingSecret: ""
     dsnKey: DB_PATH
+
+# ci#1061 - generic OIDC identity provider, rendered as the "sign in with your
+# identity provider" button next to the password form. The change is additive and
+# fails closed: while `enabled` is false the chart renders no `OCI_IDENTITY_PROVIDER_*`
+# env at all, the integration's routes answer 404 and password login is untouched.
+identityProvider:
+  enabled: false
+  # keycloak | authentik | generic. Selects default scopes and claim names; all
+  # presets use standard OIDC discovery.
+  preset: keycloak
+  # OIDC issuer URL; discovery is read from <issuer>/.well-known/openid-configuration.
+  issuer: ""
+  # OIDC client id (also the ID token audience).
+  clientID: ""
+  # Exact callback URL registered at the identity provider. Set it explicitly
+  # instead of relying on request-base detection: an inexact value is the usual
+  # cause of redirect_uri_mismatch.
+  redirectURL: ""
+  # Space or comma separated; `openid` is always included.
+  scopes: "openid profile email"
+  # Role for locally created mapped users whose mapping names none.
+  # Admin-like roles also set is_admin.
+  defaultRole: ""
+  # Keep false so an identity without a mapping never gets an account.
+  allowUnmapped: false
+  # Secret holding the confidential client credentials and the identity map.
+  # Never a secret value in a values file (same rule as the postgresql block).
+  existingSecret: ""
+  clientSecretKey: client-secret
+  bootstrapJSONKey: bootstrap-json
