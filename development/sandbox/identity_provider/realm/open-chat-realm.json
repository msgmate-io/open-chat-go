{
  "realm": "open-chat",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "open-chat",
      "name": "Open Chat (sandbox)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sandbox-only-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/api/v1/integrations/identity_provider/login/callback",
        "http://localhost:3000/api/v1/integrations/identity_provider/login/callback"
      ],
      "webOrigins": ["+"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "username": "sandbox-user",
      "enabled": true,
      "email": "sandbox-user@example.invalid",
      "emailVerified": true,
      "firstName": "Sandbox",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "sandbox-password", "temporary": false }]
    }
  ]
}
