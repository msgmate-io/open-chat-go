diff --git a/backend/templates/postgresql.yaml b/backend/templates/postgresql.yaml
new file mode 100644
index 0000000..35e15fc
--- /dev/null
+++ b/backend/templates/postgresql.yaml
@@ -0,0 +1,28 @@
+{{- $pg := .Values.postgresql | default dict }}
+{{- if eq ($pg.mode | default "off") "internal" }}
+{{- $i := $pg.internal | default dict }}
+# Managed PostgreSQL for the backend, reconciled by the CloudNativePG operator
+# (https://github.com/cloudnative-pg/charts). The backend reads the connection
+# URI from the app Secret, so no credential is ever rendered here (ci#667).
+apiVersion: postgresql.cnpg.io/v1
+kind: Cluster
+metadata:
+  name: {{ $i.name | default "backend-postgres" }}
+  namespace: {{ .Values.rootNamespace }}
+spec:
+  instances: {{ $i.instances | default 1 }}
+  imageName: {{ $i.imageName | quote }}
+  storage:
+    size: {{ $i.storage | default "5Gi" }}
+    {{- with $i.storageClassName }}
+    storageClass: {{ . }}
+    {{- end }}
+  bootstrap:
+    initdb:
+      database: {{ $i.database | default "openchat" }}
+      owner: {{ $i.owner | default "openchat" }}
+      {{- with $i.existingSecret }}
+      secret:
+        name: {{ . }}
+      {{- end }}
+{{- end }}
diff --git a/backend/values.postgresql-external.example.yaml b/backend/values.postgresql-external.example.yaml
new file mode 100644
index 0000000..a51698d
--- /dev/null
+++ b/backend/values.postgresql-external.example.yaml
@@ -0,0 +1,11 @@
+# ci#667: existing/managed PostgreSQL reached through a Secret that carries the
+# connection URI under postgresql.external.dsnKey.
+postgresql:
+  mode: external
+  external:
+    existingSecret: backend-postgres-dsn
+    dsnKey: DB_PATH
+backend:
+  sqlite:
+    persistence:
+      enabled: false
diff --git a/backend/values.postgresql-internal.example.yaml b/backend/values.postgresql-internal.example.yaml
new file mode 100644
index 0000000..331e058
--- /dev/null
+++ b/backend/values.postgresql-internal.example.yaml
@@ -0,0 +1,13 @@
+# ci#667: PostgreSQL managed in-cluster by the CloudNativePG operator.
+# Prerequisite: the operator CRDs must be installed (see the chart docs).
+postgresql:
+  mode: internal
+  internal:
+    instances: 1
+    storage: 5Gi
+    database: openchat
+    owner: openchat
+backend:
+  sqlite:
+    persistence:
+      enabled: false
diff --git a/backend/values.yaml b/backend/values.yaml
index 95580f9..fb0c138 100644
--- a/backend/values.yaml
+++ b/backend/values.yaml
@@ -25,7 +25,8 @@ backend:
   env:
     HOST: ""
     PORT: "1984"
-    DB_BACKEND: sqlite
+    # DB_BACKEND is derived from `postgresql.mode` (sqlite when off); set it here
+    # explicitly only to override that (see the postgresql block below).
     DEBUG: "false"
     START_BOT: "false"
     ROOT_CREDENTIALS: "admin:random"
@@ -81,3 +82,25 @@ ingress:
   certManager: false
   host: ""
   extraAnnotations: {}
+
+postgresql:
+  # off (SQLite, default) | internal (Cluster managed by the CloudNativePG
+  # operator) | external (bring your own server through an existing Secret).
+  mode: off
+  internal:
+    name: backend-postgres
+    instances: 1
+    imageName: ghcr.io/cloudnative-pg/postgresql:16.4
+    database: openchat
+    owner: openchat
+    storage: 5Gi
+    # storageClassName: ""
+    # Secret with the app credentials; empty = generated by CloudNativePG.
+    existingSecret: ""
+    # Key of the app Secret holding the connection URI (CNPG publishes `uri`).
+    dsnKey: uri
+  external:
+    # Secret holding the connection URI under dsnKey; never a plaintext
+    # password in a values file.
+    existingSecret: ""
+    dsnKey: DB_PATH
